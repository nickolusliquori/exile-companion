{
  "name": "exile-companion",
  "productName": "Exile Companion",
  "version": "1.13.0",
  "description": "Path of Exile 3.30 companion for Windows: build tracking from Path of Building, campaign and atlas guide, in-game overlay, Ctrl+C price checks, stash net worth and a crafting lab with real mod odds.",
  "main": "main.js",
  "license": "MIT",
  "author": "nickolusliquori",
  "homepage": "https://github.com/nickolusliquori/exile-companion",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickolusliquori/exile-companion.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win nsis",
    "dist:local": "electron-builder --win nsis -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "electron-updater": "^6.3.4"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.exilecompanion.desktop",
    "productName": "Exile Companion",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "app/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Exile-Companion-Setup-${version}.${ext}",
      "shortcutName": "Exile Companion"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nickolusliquori",
        "repo": "exile-companion",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [
    "path-of-exile",
    "poe",
    "overlay",
    "price-check",
    "path-of-building",
    "crafting",
    "electron"
  ]
}
